# LLM & Embeddings
GOOGLE_API_KEY=your_google_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Vector Database (Qdrant - Local or Cloud)
# Local Docker: http://localhost:6333
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=incident-knowledge

# Log Aggregator (Loki - Local Docker or Grafana Cloud)
# Local Docker: http://localhost:3100
# Grafana Cloud: https://logs-prod-xxx.grafana.net
LOKI_URL=http://localhost:3100
LOKI_USERNAME=your_loki_username_or_instance_id
LOKI_PASSWORD=your_loki_password_or_token

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
