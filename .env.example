# LLM & Embeddings
GOOGLE_API_KEY=your_google_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_MODEL=gemini-3.8-flash

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.cloud.qdrant.io
QDRANT_COLLECTION=incident-knowledge

# Grafana Loki Cloud
GRAFANA_NAME=your_grafanacloud_instance_name
GRAFANA_URL=https://logs-prod-xxx.grafana.net
GRAFANA_USERNAME=your_grafana_instance_id
GRAFANA_PASSWORD=your_grafana_cloud_api_token

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
